# Copy this file to ".env" and fill in your own values.

# PostgreSQL connection string.
# Local format:  postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Hosted (Neon): copy the connection string from the Neon dashboard, e.g.
#   postgres://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/karorganics ?sslmode=require
# SSL is enabled automatically for any non-localhost host.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/karorganics 

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (your frontend).
# Vite dev server defaults to http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Admin dashboard login credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Secret used to sign admin login tokens. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-secret

# Gmail / Google Workspace account used to send the "Email Subscribers"
# broadcast from the admin dashboard. Requires 2-Step Verification enabled
# on the Google account, then create an App Password at:
#   https://myaccount.google.com/apppasswords
# (choose "Mail" as the app) and paste the generated 16-character password
# below — NOT your regular Google account password.
EMAIL_USER=hello@karorganics.ug
EMAIL_APP_PASSWORD=your-16-character-app-password
